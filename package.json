{
  "name": "cold-call-coach",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @ccc/api start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "db:migrate": "pnpm --filter @ccc/api db:migrate",
    "avatar:fetch": "node scripts/fetch-avatar.mjs",
    "simulate": "node scripts/simulate-call.ts"
  },
  "devDependencies": {
    "@ccc/contracts": "workspace:*",
    "@ccc/core": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
