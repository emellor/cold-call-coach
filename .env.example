# Copy to .env (git-ignored) and fill in. Every app reads the repo-root .env;
# variables already set in the real environment take precedence.

# Postgres. Matches docker-compose.yml; the API falls back to this outside production.
DATABASE_URL=postgres://coach:coach@localhost:5432/coach

# LiveKit Cloud project (Settings → Keys). The API mints room tokens with these and
# the agent registers with them. Without them the agent prints a notice and exits.
# LIVEKIT_URL looks like wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Claude. Used only by the agent (prospect, judge, hints) and the API (post-call review).
ANTHROPIC_API_KEY=
# Only for a key that belongs to your organization rather than a workspace, which
# Claude refuses as "not scoped to a workspace": the workspace to use (wrkspc_…).
# Set it wherever ANTHROPIC_API_KEY is set. A key created in a workspace needs nothing.
ANTHROPIC_WORKSPACE_ID=

# Deepgram speech-to-text (Nova-3). Agent only.
DEEPGRAM_API_KEY=

# Cartesia text-to-speech (Sonic 3). Agent only.
CARTESIA_API_KEY=
# Each scenario file names its own voice (voice.voiceId). This is the fallback for
# a scenario whose voiceId is still REPLACE_WITH_CARTESIA_VOICE_ID.
CARTESIA_VOICE_ID=

# Where the agent reaches the API (scenario lookup, call log upload).
API_BASE_URL=http://localhost:3000
# Render only (render.yaml fills it in): the API's private host:port. The agent
# builds http://host:port from it when API_BASE_URL is unset.
API_HOSTPORT=
# Shared secret for the agent → API /internal routes (x-internal-secret header).
# This value works locally; the API refuses it in production, so generate a real
# one there with `openssl rand -hex 32`.
INTERNAL_API_SECRET=dev-only-internal-secret

# Model and effort per Claude lane. Effort is low | medium | high | xhigh | max.
# Setting PROSPECT_MODEL=claude-haiku-4-5 is the latency lever (PLAN.md §6.5);
# Haiku takes no effort setting, so PROSPECT_EFFORT is ignored for it.
PROSPECT_MODEL=claude-opus-5
PROSPECT_EFFORT=low
# The coach: the judge behind her mood, the live tips and stages, and the Hint button
# (which should answer in about 2 s).
COACH_MODEL=claude-opus-5
COACH_EFFORT=low
REVIEW_MODEL=claude-opus-5
REVIEW_EFFORT=high
# `pnpm simulate` only: the model that plays the rep (default claude-opus-5).
SIM_REP_MODEL=

# Turn detector: `multilingual` (PLAN.md's text model; run
# `pnpm --filter @ccc/agent download-files` once first) or `audio` (LiveKit's newer
# on-device audio model, which needs no download).
TURN_DETECTOR=multilingual

# Where the agent keeps a call log it couldn't post because the API was down;
# the next call sends it. Default: a folder in the OS temp dir.
AGENT_SPOOL_DIR=

# Deployed instances only: the one sign-in password (8 characters or more). The
# API trades it for a session cookie, and every /api route then needs that cookie.
# Leave it empty locally, where there is no sign-in. In production the API refuses
# to start without it.
APP_PASSWORD=
